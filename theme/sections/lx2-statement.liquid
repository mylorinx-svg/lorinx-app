{%- comment -%}
  lx2 statement: oversized words stacked down the page. Each one lights up as it passes the middle of the screen,
  with a short line beside it. Brand-level wording only: nothing here names a product.
{%- endcomment -%}
<section class="lx2 lx-sec lx-stmt lx-tone-{{ section.settings.tone }}" {% if section.settings.anchor != blank %}id="{{ section.settings.anchor | handleize }}"{% endif %}>
  <div class="lx-wrap">
    {%- if section.settings.eyebrow != blank -%}<span class="lx-eyebrow">{{ section.settings.eyebrow | escape }}</span>{%- endif -%}
    <ol class="lx-stmt__list" data-stmt>
      {%- for block in section.blocks -%}
        <li class="lx-stmt__row" {{ block.shopify_attributes }}>
          <span class="lx-stmt__word">{{ block.settings.word | escape }}</span>
          <span class="lx-stmt__line">{{ block.settings.text | escape }}</span>
        </li>
      {%- endfor -%}
    </ol>
  </div>
</section>
{% schema %}
{
  "name": "LORINX הצהרה גדולה",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "anchor", "label": "מזהה עוגן (אנגלית)" },
    { "type": "text", "id": "eyebrow", "label": "כותרת עליונה" },
    { "type": "select", "id": "tone", "label": "רקע", "default": "dark", "options": [
      { "value": "bg", "label": "בהיר" }, { "value": "surface", "label": "לבן חם" }, { "value": "sand", "label": "חול" }, { "value": "dark", "label": "כהה" } ] }
  ],
  "blocks": [{ "type": "row", "name": "שורה", "settings": [
    { "type": "text", "id": "word", "label": "מילה גדולה" },
    { "type": "text", "id": "text", "label": "משפט קצר לצידה" } ] }],
  "presets": [{ "name": "LORINX הצהרה גדולה" }]
}
{% endschema %}
