{%- comment -%}
  lx2 reviews: customer quotes entered by the merchant + optional screenshots of real customer messages.
  IMPORTANT: this section only displays what the merchant enters. Enter genuine customer feedback only,
  and fill the rating line / "verified" label only if they are backed by real, collected reviews.
{%- endcomment -%}
{%- liquid
  assign show = true
  if section.settings.only_for != blank and section.settings.only_for.handle != product.handle
    assign show = false
  endif
-%}
{%- if show -%}
<section class="lx2 lx-sec lx-tone-{{ section.settings.tone }}" id="reviews">
  <div class="lx-wrap">
    <div class="lx-head" data-lx-reveal>
      {%- if section.settings.eyebrow != blank -%}<span class="lx-eyebrow">{{ section.settings.eyebrow | escape }}</span>{%- endif -%}
      <h2 class="lx-h2">{{ section.settings.heading | escape }}</h2>
      {%- if section.settings.rating_line != blank -%}
        <p class="lx-rev__meta"><span class="lx-stars" aria-hidden="true">★★★★★</span>{{ section.settings.rating_line | escape }}</p>
      {%- endif -%}
    </div>
    {%- assign quotes = section.blocks | where: 'type', 'quote' -%}
    {%- assign shots = section.blocks | where: 'type', 'screenshot' -%}
    {%- if quotes.size > 0 -%}
      <div class="lx-rev__track {% if quotes.size <= 3 %}lx-rev__track--3{% endif %}" tabindex="0" role="group" aria-label="ציטוטים מלקוחות">
        {%- for block in quotes -%}
          <figure class="lx-rev" {{ block.shopify_attributes }}>
            {%- if block.settings.image -%}
              <div class="lx-media lx-rev__img">{{ block.settings.image | image_url: width: 760 | image_tag: loading: 'lazy', widths: '380, 760', sizes: '380px', alt: 'תמונה ששלח לקוח' }}</div>
            {%- endif -%}
            <span class="lx-stars" aria-label="חמישה כוכבים">★★★★★</span>
            <blockquote>{{ block.settings.quote | escape }}</blockquote>
            <footer><b>{{ block.settings.author | escape }}</b>{%- if section.settings.verified_label != blank -%}<span>{{ section.settings.verified_label | escape }}</span>{%- endif -%}</footer>
          </figure>
        {%- endfor -%}
      </div>
    {%- endif -%}
    {%- if shots.size > 0 -%}
      <div class="lx-shots">
        {%- if section.settings.shots_heading != blank -%}<h3 class="lx-h3" style="margin-bottom:22px">{{ section.settings.shots_heading | escape }}</h3>{%- endif -%}
        <div class="lx-shots__track" tabindex="0" role="group" aria-label="{{ section.settings.shots_heading | escape }}">
          {%- for block in shots -%}
            {%- if block.settings.image -%}
              <div class="lx-media" {{ block.shopify_attributes }}>{{ block.settings.image | image_url: width: 600 | image_tag: loading: 'lazy', widths: '300, 600', sizes: '250px', alt: 'צילום מסך של הודעה מלקוח' }}</div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}
  </div>
</section>
{%- endif -%}
{% schema %}
{
  "name": "LORINX לקוחות מספרים",
  "max_blocks": 16,
  "settings": [
    { "type": "product", "id": "only_for", "label": "להציג רק במוצר (ריק = תמיד)" },
    { "type": "paragraph", "content": "יש להזין רק ציטוטים אמיתיים של לקוחות. שורת הדירוג ותווית האימות מוצגות רק אם מילאתם אותן." },
    { "type": "text", "id": "eyebrow", "label": "כותרת עליונה" },
    { "type": "text", "id": "heading", "label": "כותרת", "default": "לקוחות מספרים" },
    { "type": "text", "id": "rating_line", "label": "שורת דירוג (אופציונלי)" },
    { "type": "text", "id": "verified_label", "label": "תווית ליד שם הלקוח (אופציונלי)" },
    { "type": "text", "id": "shots_heading", "label": "כותרת לצילומי המסך", "default": "הודעות שקיבלנו מלקוחות" },
    { "type": "select", "id": "tone", "label": "רקע", "default": "bg", "options": [
      { "value": "bg", "label": "בהיר" }, { "value": "surface", "label": "לבן חם" }, { "value": "sand", "label": "חול" }, { "value": "dark", "label": "כהה" } ] }
  ],
  "blocks": [
    { "type": "quote", "name": "ציטוט", "settings": [
      { "type": "textarea", "id": "quote", "label": "ציטוט" },
      { "type": "text", "id": "author", "label": "שם" },
      { "type": "image_picker", "id": "image", "label": "תמונה מהלקוח (אופציונלי)" } ] },
    { "type": "screenshot", "name": "צילום מסך", "settings": [{ "type": "image_picker", "id": "image", "label": "תמונה" }] }
  ],
  "presets": [{ "name": "LORINX לקוחות מספרים" }]
}
{% endschema %}
