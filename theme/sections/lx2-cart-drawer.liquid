{%- comment -%}
  lx2 cart drawer body. Fetched on demand through the Section Rendering API
  (/?section_id=lx2-cart-drawer) and injected into #lx-cart-mount by lx2.js.
  Checkout is the standard Shopify form post — nothing about checkout is replaced.
{%- endcomment -%}
<div id="lx-cart-inner" class="lx-cart" data-count="{{ cart.item_count }}" style="display:flex;flex-direction:column;flex:1;min-height:0">
  {%- if cart.item_count == 0 -%}
    <div class="lx-panel__body">
      <div class="lx-cart__empty">
        <h3 class="lx-h3">הסל עדיין ריק</h3>
        <p>כשתוסיפו מוצר, הוא יחכה לכם כאן.</p>
        <a class="lx-btn" href="{{ pages['המוצרים-שלנו'].url }}">לכל המוצרים</a>
      </div>
    </div>
  {%- else -%}
    <div class="lx-panel__body">
      <ul>
        {%- for item in cart.items -%}
          {%- capture t -%}{% assign line_title = item.product.title | default: item.title %}{% render 'lx2-title', title: line_title %}{%- endcapture -%}
          <li class="lx-line">
            <a class="lx-media lx-line__img" href="{{ item.url }}" tabindex="-1" aria-hidden="true">
              {%- if item.image -%}{{ item.image | image_url: width: 240 | image_tag: loading: 'lazy', alt: '' }}{%- endif -%}
            </a>
            <div>
              <a class="lx-line__t" href="{{ item.url }}">{{ t }}</a>
              {%- if item.variant.title != blank and item.variant.title != 'Default Title' -%}<p class="lx-line__v">{{ item.variant.title | escape }}</p>{%- endif -%}
              <div class="lx-line__row">
                <div class="lx-qty" role="group" aria-label="כמות">
                  <button type="button" data-lx-qty="{{ item.quantity | minus: 1 }}" data-key="{{ item.key }}" aria-label="הפחתת כמות">−</button>
                  <span aria-live="polite">{{ item.quantity }}</span>
                  <button type="button" data-lx-qty="{{ item.quantity | plus: 1 }}" data-key="{{ item.key }}" aria-label="הוספת כמות">+</button>
                </div>
                <span class="lx-line__price">{{ item.final_line_price | money }}</span>
              </div>
              <button type="button" class="lx-line__rm" data-lx-qty="0" data-key="{{ item.key }}">הסרה</button>
            </div>
          </li>
        {%- endfor -%}
      </ul>
    </div>
    <div class="lx-panel__foot">
      <div class="lx-cart__sum"><span>סכום ביניים</span><span>{{ cart.total_price | money }}</span></div>
      <p class="lx-cart__note">משלוח חינם.</p>
      <form action="{{ routes.cart_url }}" method="post">
        <button type="submit" name="checkout" class="lx-btn lx-btn--block">{% render 'lx2-icon', name: 'lock' %}מעבר לתשלום מאובטח</button>
      </form>
      <p style="text-align:center;margin-top:12px"><a class="lx-line__rm" href="{{ routes.cart_url }}">צפייה בסל המלא</a></p>
    </div>
  {%- endif -%}
</div>

{% schema %}
{ "name": "LORINX מגירת סל", "settings": [] }
{% endschema %}
