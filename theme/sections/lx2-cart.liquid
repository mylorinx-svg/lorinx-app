{%- comment -%} lx2 cart page. Standard Shopify cart form; checkout is the untouched Shopify checkout. {%- endcomment -%}
<div class="lx2">
  <div class="lx-wrap">
    <header class="lx-pagehero">
      <h1 class="lx-h1">הסל שלכם</h1>
    </header>
    {%- if cart.item_count == 0 -%}
      <div class="lx-cart__empty" style="padding-bottom:var(--lx-sec)">
        <h2 class="lx-h3">הסל עדיין ריק</h2>
        <p>נראה שעוד לא הוספתם מוצרים.</p>
        <a class="lx-btn" href="{{ pages['המוצרים-שלנו'].url }}">לכל המוצרים</a>
      </div>
    {%- else -%}
      <form action="{{ routes.cart_url }}" method="post" class="lx-cartpage lx-cart" data-lx-cartpage style="padding-bottom:var(--lx-sec)">
        <ul style="border-top:1px solid var(--lx-line)">
          {%- for item in cart.items -%}
            {%- capture t -%}{% assign line_title = item.product.title | default: item.title %}{% render 'lx2-title', title: line_title %}{%- endcapture -%}
            <li class="lx-line">
              <a class="lx-media lx-line__img" href="{{ item.url }}" tabindex="-1" aria-hidden="true">
                {%- if item.image -%}{{ item.image | image_url: width: 360 | image_tag: loading: 'lazy', alt: '' }}{%- endif -%}
              </a>
              <div>
                <a class="lx-line__t" href="{{ item.url }}" style="font-size:17px">{{ t }}</a>
                {%- if item.variant.title != blank and item.variant.title != 'Default Title' -%}<p class="lx-line__v">{{ item.variant.title | escape }}</p>{%- endif -%}
                {%- for discount in item.line_level_discount_allocations -%}<p class="lx-line__v">{{ discount.discount_application.title | escape }} (−{{ discount.amount | money }})</p>{%- endfor -%}
                <div class="lx-line__row">
                  <div class="lx-qty" role="group" aria-label="כמות">
                    <button type="button" data-lx-qty="{{ item.quantity | minus: 1 }}" data-key="{{ item.key }}" aria-label="הפחתת כמות">−</button>
                    <span>{{ item.quantity }}</span>
                    <input type="hidden" name="updates[]" value="{{ item.quantity }}">
                    <button type="button" data-lx-qty="{{ item.quantity | plus: 1 }}" data-key="{{ item.key }}" aria-label="הוספת כמות">+</button>
                  </div>
                  <span class="lx-line__price">{{ item.final_line_price | money }}</span>
                </div>
                <a class="lx-line__rm" href="{{ item.url_to_remove }}" style="display:inline-block">הסרה</a>
              </div>
            </li>
          {%- endfor -%}
        </ul>
        <aside class="lx-cartpage__side" aria-label="סיכום הזמנה">
          <h2 class="lx-h3" style="margin-bottom:18px">סיכום</h2>
          {%- for discount in cart.cart_level_discount_applications -%}
            <div class="lx-cart__sum" style="font-size:14px;font-weight:400;margin-bottom:8px"><span>{{ discount.title | escape }}</span><span>−{{ discount.total_allocated_amount | money }}</span></div>
          {%- endfor -%}
          <div class="lx-cart__sum" style="font-size:15px;font-weight:400;margin-bottom:8px"><span>משלוח</span><span>חינם</span></div>
          <div class="lx-cart__sum" style="padding-top:14px;border-top:1px solid var(--lx-line)"><span>סכום ביניים</span><span>{{ cart.total_price | money }}</span></div>
          <p class="lx-cart__note">הסכום הסופי מוצג בעמוד התשלום.</p>
          <button type="submit" name="checkout" class="lx-btn lx-btn--block">{% render 'lx2-icon', name: 'lock' %}מעבר לתשלום מאובטח</button>
          <ul class="lx-buy__assure">
            <li>{% render 'lx2-icon', name: 'truck' %}<span>אספקה משוערת 7–14 ימי עסקים</span></li>
            <li>{% render 'lx2-icon', name: 'return' %}<span>14 יום להחזרה, בלי דמי ביטול</span></li>
            <li>{% render 'lx2-icon', name: 'shield' %}<span>אחריות לשנה</span></li>
          </ul>
          {%- if shop.enabled_payment_types.size > 0 -%}
            <div class="lx-pay" aria-label="אמצעי תשלום">{%- for type in shop.enabled_payment_types -%}{{ type | payment_type_svg_tag }}{%- endfor -%}</div>
          {%- endif -%}
          <p style="margin-top:18px"><a class="lx-link" href="{{ pages['המוצרים-שלנו'].url }}">המשך בקניות{% render 'lx2-icon', name: 'arrow' %}</a></p>
        </aside>
      </form>
    {%- endif -%}
  </div>
</div>
{% schema %}
{ "name": "LORINX סל קניות", "settings": [] }
{% endschema %}
