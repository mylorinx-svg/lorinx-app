{%- comment -%}
  lx2 hero (cinematic): a live "ember" aura behind the product, one message, one primary action,
  and a rail of four product facts. The product image is the LCP element. The aura canvas is
  decorative, pauses off-screen and falls back to a CSS gradient without WebGL.
{%- endcomment -%}
{%- assign hero_alt = section.settings.image.alt | default: section.settings.heading | strip_newlines -%}
<section class="lx2 lx-hero" data-lx-hero>
  <div class="lx-aura-wrap" aria-hidden="true"><canvas class="lx-aura" data-lx-aura="{{ section.settings.aura | divided_by: 100.0 }}"></canvas></div>
  <div class="lx-wrap lx-hero__in">
    <div class="lx-hero__meta" data-lx-in style="--s:0">
      {%- if section.settings.eyebrow != blank -%}<span class="lx-eyebrow">{{ section.settings.eyebrow | escape }}</span>{%- endif -%}
      {%- if section.settings.index != blank -%}<span>{{ section.settings.index | escape }}</span>{%- endif -%}
    </div>
    <div class="lx-hero__stage">
      <div class="lx-hero__media" data-lx-parallax="-0.08">
        {%- if section.settings.image -%}
          {{ section.settings.image | image_url: width: 1600 | image_tag:
            widths: '480, 640, 800, 1100, 1600',
            sizes: '(min-width: 990px) 60vw, 100vw',
            loading: 'eager', fetchpriority: 'high',
            alt: hero_alt }}
        {%- endif -%}
      </div>
      <div class="lx-hero__copy">
        <h1 class="lx-h1" data-lx-split>{{ section.settings.heading | escape | newline_to_br }}</h1>
        {%- if section.settings.text != blank -%}<p class="lx-lead" data-lx-in style="--s:4">{{ section.settings.text | escape }}</p>{%- endif -%}
        <div class="lx-actions" data-lx-in style="--s:5">
          {%- if section.settings.cta_label != blank -%}<a class="lx-btn" href="{{ section.settings.cta_url | default: routes.all_products_collection_url }}">{{ section.settings.cta_label | escape }}</a>{%- endif -%}
          {%- if section.settings.link_label != blank -%}<a class="lx-btn lx-btn--ghost" href="{{ section.settings.link_url }}">{{ section.settings.link_label | escape }}</a>{%- endif -%}
        </div>
      </div>
    </div>
    {%- if section.blocks.size > 0 -%}
      <ul class="lx-hero__rail" data-lx-in style="--s:6">
        {%- for block in section.blocks -%}
          <li class="lx-hero__stat" {{ block.shopify_attributes }}><b>{{ block.settings.value | escape }}</b><span>{{ block.settings.label | escape }}</span></li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</section>
{% schema %}
{
  "name": "LORINX הירו",
  "max_blocks": 4,
  "settings": [
    { "type": "image_picker", "id": "image", "label": "תמונת מוצר (רקע כהה)" },
    { "type": "range", "id": "aura", "label": "עוצמת הזוהר ברקע", "min": 0, "max": 140, "step": 10, "unit": "%", "default": 100 },
    { "type": "text", "id": "eyebrow", "label": "כותרת עליונה" },
    { "type": "text", "id": "index", "label": "תווית בצד השני" },
    { "type": "textarea", "id": "heading", "label": "כותרת ראשית", "default": "שחרור.\nבבית, בזמן שלכם." },
    { "type": "textarea", "id": "text", "label": "טקסט" },
    { "type": "text", "id": "cta_label", "label": "כפתור ראשי" },
    { "type": "url", "id": "cta_url", "label": "קישור כפתור" },
    { "type": "text", "id": "link_label", "label": "כפתור משני" },
    { "type": "url", "id": "link_url", "label": "קישור כפתור משני" }
  ],
  "blocks": [{ "type": "stat", "name": "עובדה", "settings": [
    { "type": "text", "id": "value", "label": "ערך" },
    { "type": "text", "id": "label", "label": "תיאור" } ] }],
  "presets": [{ "name": "LORINX הירו" }]
}
{% endschema %}
