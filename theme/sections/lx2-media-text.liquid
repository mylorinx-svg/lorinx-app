{%- comment -%} lx2 media + text: editorial image (or muted looping video) beside copy and optional check list. {%- endcomment -%}
{%- liquid
  assign show = true
  if section.settings.only_for != blank and section.settings.only_for.handle != product.handle
    assign show = false
  endif
-%}
{%- if show -%}
<section class="lx2 lx-sec lx-tone-{{ section.settings.tone }}" {% if section.settings.anchor != blank %}id="{{ section.settings.anchor | handleize }}"{% endif %}>
  <div class="lx-wrap lx-mt {% if section.settings.flip %}lx-mt--flip{% endif %}">
    <div class="lx-media lx-mt__media lx-ratio-{{ section.settings.ratio }}" data-lx-reveal>
      {%- if section.settings.video_url != blank -%}
        <video src="{{ section.settings.video_url }}" {% if section.settings.image %}poster="{{ section.settings.image | image_url: width: 900 }}"{% endif %} muted loop playsinline controls preload="none" aria-label="{{ section.settings.heading | escape }}"></video>
      {%- elsif section.settings.image -%}
        {{ section.settings.image | image_url: width: 1400 | image_tag:
          widths: '400, 600, 800, 1100, 1400', sizes: '(min-width: 900px) 46vw, 100vw', loading: 'lazy',
          alt: section.settings.image.alt | default: section.settings.heading }}
      {%- else -%}
        {{ 'lifestyle-2' | placeholder_svg_tag }}
      {%- endif -%}
    </div>
    <div data-lx-reveal>
      {%- if section.settings.eyebrow != blank -%}<span class="lx-eyebrow">{{ section.settings.eyebrow | escape }}</span>{%- endif -%}
      <h2 class="lx-h2">{{ section.settings.heading | escape }}</h2>
      {%- if section.settings.text != blank -%}<div class="lx-lead lx-rte" style="margin-top:18px">{{ section.settings.text }}</div>{%- endif -%}
      {%- if section.blocks.size > 0 -%}
        <ul class="lx-mt__checks">
          {%- for block in section.blocks -%}<li {{ block.shopify_attributes }}>{% render 'lx2-icon', name: 'check' %}<span>{{ block.settings.text | escape }}</span></li>{%- endfor -%}
        </ul>
      {%- endif -%}
      {%- if section.settings.cta_label != blank or section.settings.link_label != blank -%}
        <div class="lx-actions">
          {%- if section.settings.cta_label != blank -%}<a class="lx-btn {% if section.settings.tone == 'dark' %}lx-btn--light{% endif %}" href="{{ section.settings.cta_url }}">{{ section.settings.cta_label | escape }}</a>{%- endif -%}
          {%- if section.settings.link_label != blank -%}<a class="lx-link" href="{{ section.settings.link_url }}">{{ section.settings.link_label | escape }}{% render 'lx2-icon', name: 'arrow' %}</a>{%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>
{%- endif -%}
{% schema %}
{
  "name": "LORINX תמונה וטקסט",
  "max_blocks": 8,
  "settings": [
    { "type": "product", "id": "only_for", "label": "להציג רק במוצר (ריק = תמיד)" },
    { "type": "text", "id": "anchor", "label": "מזהה עוגן (אנגלית)" },
    { "type": "image_picker", "id": "image", "label": "תמונה" },
    { "type": "text", "id": "video_url", "label": "כתובת וידאו MP4 (מחליף את התמונה)" },
    { "type": "select", "id": "ratio", "label": "יחס תמונה", "default": "45", "options": [
      { "value": "1", "label": "1:1" }, { "value": "45", "label": "4:5" }, { "value": "34", "label": "3:4" }, { "value": "32", "label": "3:2" }, { "value": "169", "label": "16:9" } ] },
    { "type": "checkbox", "id": "flip", "label": "תמונה בצד השני", "default": false },
    { "type": "text", "id": "eyebrow", "label": "כותרת עליונה" },
    { "type": "text", "id": "heading", "label": "כותרת", "default": "כותרת" },
    { "type": "richtext", "id": "text", "label": "טקסט" },
    { "type": "text", "id": "cta_label", "label": "כפתור" },
    { "type": "url", "id": "cta_url", "label": "קישור כפתור" },
    { "type": "text", "id": "link_label", "label": "קישור משני" },
    { "type": "url", "id": "link_url", "label": "כתובת קישור משני" },
    { "type": "select", "id": "tone", "label": "רקע", "default": "bg", "options": [
      { "value": "bg", "label": "בהיר" }, { "value": "surface", "label": "לבן חם" }, { "value": "sand", "label": "חול" }, { "value": "dark", "label": "כהה" } ] }
  ],
  "blocks": [{ "type": "check", "name": "שורת וי", "settings": [{ "type": "text", "id": "text", "label": "טקסט" }] }],
  "presets": [{ "name": "LORINX תמונה וטקסט" }]
}
{% endschema %}
