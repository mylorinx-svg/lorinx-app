{%- comment -%} lx2 product card. Params: product, eager (boolean), sizes {%- endcomment -%}
{%- capture t -%}{% render 'lx2-title', title: product.title %}{%- endcapture -%}
<a class="lx-card" href="{{ product.url }}">
  <div class="lx-media lx-ratio-45">
    {%- if product.featured_media -%}
      {{ product.featured_media | image_url: width: 900 | image_tag:
        widths: '300, 450, 600, 900',
        sizes: sizes | default: '(min-width: 750px) 25vw, 50vw',
        loading: 'lazy',
        alt: product.featured_media.alt | default: t }}
    {%- endif -%}
  </div>
  <div>
    <h3 class="lx-card__t">{{ t }}</h3>
    <p class="lx-card__p">
      {%- if product.price_varies -%}החל מ־<b>{{ product.price_min | money }}</b>{%- else -%}<b>{{ product.price | money }}</b>{%- endif -%}
      {%- unless product.available %} · אזל מהמלאי{% endunless -%}
    </p>
  </div>
</a>
