{%- comment -%} lx2 facts strip: up to four short, factual statements with an icon. {%- endcomment -%}
{%- liquid
  assign show = true
  if section.settings.only_for != blank and section.settings.only_for != product.handle
    assign show = false
  endif
-%}
{%- if show -%}
<section class="lx2 lx-facts lx-tone-{{ section.settings.tone }}" aria-label="{{ section.settings.label | escape }}">
  <div class="lx-wrap">
    <ul class="lx-facts__grid">
      {%- for block in section.blocks -%}
        <li class="lx-fact" {{ block.shopify_attributes }}>
          {% render 'lx2-icon', name: block.settings.icon %}
          <div><b>{{ block.settings.title | escape }}</b>{%- if block.settings.text != blank -%}<span>{{ block.settings.text | escape }}</span>{%- endif -%}</div>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>
{%- endif -%}
{% schema %}
{
  "name": "LORINX פס עובדות",
  "max_blocks": 4,
  "settings": [
    { "type": "text", "id": "only_for", "label": "להציג רק במוצר — handle של המוצר (ריק = בכל מקום)" },
    { "type": "text", "id": "label", "label": "תיאור נגישות", "default": "עיקרי הדברים" },
    { "type": "select", "id": "tone", "label": "רקע", "default": "bg", "options": [
      { "value": "bg", "label": "בהיר" }, { "value": "surface", "label": "לבן חם" }, { "value": "sand", "label": "חול" }, { "value": "dark", "label": "כהה" } ] }
  ],
  "blocks": [{ "type": "fact", "name": "עובדה", "settings": [
    { "type": "select", "id": "icon", "label": "אייקון", "default": "check", "options": [
      { "value": "check", "label": "וי" }, { "value": "truck", "label": "משלוח" }, { "value": "return", "label": "החזרה" }, { "value": "shield", "label": "אחריות" },
      { "value": "chat", "label": "שירות" }, { "value": "levels", "label": "עוצמות" }, { "value": "heat", "label": "חום" }, { "value": "battery", "label": "סוללה" },
      { "value": "clock", "label": "זמן" }, { "value": "lock", "label": "מאובטח" } ] },
    { "type": "text", "id": "title", "label": "כותרת" },
    { "type": "text", "id": "text", "label": "טקסט" } ] }],
  "presets": [{ "name": "LORINX פס עובדות" }]
}
{% endschema %}
