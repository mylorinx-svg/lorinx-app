{%- comment -%}
  lx2 hero (cinematic): a live "ember" aura behind the product, one message, one primary action,
  and a rail of four product facts. The product image is the LCP element. The aura canvas is
  decorative, pauses off-screen and falls back to a CSS gradient without WebGL.
{%- endcomment -%}
{%- assign hero_alt = section.settings.image.alt | default: section.settings.heading | strip_newlines -%}
{%- liquid
  assign has_bg = false
  if section.settings.bg_image != blank or section.settings.bg_asset != blank
    assign has_bg = true
  endif
-%}
<section class="lx2 lx-hero {% if has_bg %}lx-hero--photo{% endif %}" data-lx-hero>
  {%- if has_bg -%}
    <div class="lx-hero__bg" data-lx-parallax="0.12" aria-hidden="true">
      {%- if section.settings.bg_image != blank -%}
        {{ section.settings.bg_image | image_url: width: 2400 | image_tag:
          widths: '640, 900, 1200, 1600, 2000, 2400', sizes: '100vw',
          loading: 'eager', fetchpriority: 'high', alt: '' }}
      {%- else -%}
        <img src="{{ section.settings.bg_asset | asset_img_url: '1600x' }}"
          srcset="{{ section.settings.bg_asset | asset_img_url: '800x' }} 800w, {{ section.settings.bg_asset | asset_img_url: '1200x' }} 1200w, {{ section.settings.bg_asset | asset_img_url: '1600x' }} 1600w, {{ section.settings.bg_asset | asset_img_url: '2400x' }} 2400w"
          sizes="100vw" width="1600" height="900" alt="" loading="eager" fetchpriority="high">
      {%- endif -%}
      {%- if section.settings.bg_video != blank -%}
        {%- if section.settings.bg_video contains '://' -%}{%- assign hero_video = section.settings.bg_video -%}{%- else -%}{%- assign hero_video = section.settings.bg_video | asset_url -%}{%- endif -%}
        <video class="lx-hero__vid" muted playsinline preload="none" tabindex="-1" data-lx-herovideo data-src="{{ hero_video }}"></video>
      {%- endif -%}
    </div>
  {%- endif -%}
  {%- if section.settings.aura > 0 -%}
    <div class="lx-aura-wrap" aria-hidden="true"><canvas class="lx-aura" data-lx-aura="{{ section.settings.aura | divided_by: 100.0 }}"></canvas></div>
  {%- endif -%}
  <div class="lx-wrap lx-hero__in">
    <div class="lx-hero__meta" data-lx-in style="--s:0">
      {%- if section.settings.eyebrow != blank -%}<span class="lx-eyebrow">{{ section.settings.eyebrow | escape }}</span>{%- endif -%}
      {%- if section.settings.index != blank -%}<span>{{ section.settings.index | escape }}</span>{%- endif -%}
      {%- if has_bg and section.settings.focus and section.settings.focus_hint != blank -%}<span class="lx-hero__hint">{{ section.settings.focus_hint | escape }}</span>{%- endif -%}
    </div>
    <div class="lx-hero__stage">
      {%- if section.settings.image -%}
        <div class="lx-hero__media" data-lx-parallax="-0.08">
          {%- if has_bg -%}
            {{ section.settings.image | image_url: width: 1600 | image_tag: widths: '480, 640, 800, 1100, 1600', sizes: '(min-width: 990px) 60vw, 100vw', loading: 'lazy', alt: hero_alt }}
          {%- else -%}
            {{ section.settings.image | image_url: width: 1600 | image_tag: widths: '480, 640, 800, 1100, 1600', sizes: '(min-width: 990px) 60vw, 100vw', loading: 'eager', fetchpriority: 'high', alt: hero_alt }}
          {%- endif -%}
        </div>
      {%- endif -%}
      <div class="lx-hero__copy">
        <h1 class="lx-h1" data-lx-split>{{ section.settings.heading | escape | newline_to_br }}</h1>
        {%- if section.settings.text != blank -%}<p class="lx-lead" data-lx-in style="--s:4">{{ section.settings.text | escape }}</p>{%- endif -%}
        <div class="lx-actions" data-lx-in style="--s:5">
          {%- if section.settings.cta_label != blank -%}<a class="lx-btn" href="{{ section.settings.cta_url | default: routes.all_products_collection_url }}">{{ section.settings.cta_label | escape }}</a>{%- endif -%}
          {%- if section.settings.link_label != blank -%}<a class="lx-btn lx-btn--ghost" href="{{ section.settings.link_url }}">{{ section.settings.link_label | escape }}</a>{%- endif -%}
        </div>
      </div>
    </div>
    {%- if section.blocks.size > 0 -%}
      <ul class="lx-hero__rail" data-lx-in style="--s:6">
        {%- for block in section.blocks -%}
          <li class="lx-hero__stat" {{ block.shopify_attributes }}><b>{{ block.settings.value | escape }}</b><span>{{ block.settings.label | escape }}</span></li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</section>
{% schema %}
{
  "name": "LORINX הירו",
  "max_blocks": 4,
  "settings": [
    { "type": "header", "content": "תמונת רקע על כל ההירו" },
    { "type": "image_picker", "id": "bg_image", "label": "תמונת רקע (מומלץ 2400×1350)" },
    { "type": "text", "id": "bg_asset", "label": "או שם קובץ תמונה מנכסי התבנית", "info": "משמש רק אם לא נבחרה תמונת רקע למעלה" },
    { "type": "checkbox", "id": "focus", "label": "רמז לאפקט גרירת האוויר (בדסקטופ)", "default": true },
    { "type": "text", "id": "focus_hint", "label": "טקסט הרמז", "default": "הזיזו את העכבר" },
    { "type": "text", "id": "bg_video", "label": "וידאו רקע (שם קובץ בנכסי התבנית או כתובת MP4 מלאה)", "info": "קליפ קצר בלי סאונד. התמונה למעלה מוצגת עד שהוידאו נטען, ובמכשירים עם הפחתת תנועה." },
    { "type": "header", "content": "מוצר צף (אופציונלי)" },
    { "type": "image_picker", "id": "image", "label": "תמונת מוצר (רקע כהה)" },
    { "type": "range", "id": "aura", "label": "עוצמת הזוהר ברקע", "min": 0, "max": 140, "step": 10, "unit": "%", "default": 0 },
    { "type": "text", "id": "eyebrow", "label": "כותרת עליונה" },
    { "type": "text", "id": "index", "label": "תווית בצד השני" },
    { "type": "textarea", "id": "heading", "label": "כותרת ראשית", "default": "שחרור.\nבבית, בזמן שלכם." },
    { "type": "textarea", "id": "text", "label": "טקסט" },
    { "type": "text", "id": "cta_label", "label": "כפתור ראשי" },
    { "type": "url", "id": "cta_url", "label": "קישור כפתור" },
    { "type": "text", "id": "link_label", "label": "כפתור משני" },
    { "type": "url", "id": "link_url", "label": "קישור כפתור משני" }
  ],
  "blocks": [{ "type": "stat", "name": "עובדה", "settings": [
    { "type": "text", "id": "value", "label": "ערך" },
    { "type": "text", "id": "label", "label": "תיאור" } ] }],
  "presets": [{ "name": "LORINX הירו" }]
}
{% endschema %}
