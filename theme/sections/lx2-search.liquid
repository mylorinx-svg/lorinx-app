{%- comment -%} lx2 search results. {%- endcomment -%}
<div class="lx2">
  <div class="lx-wrap">
    <header class="lx-pagehero">
      <span class="lx-eyebrow">חיפוש</span>
      <h1 class="lx-h2">{% if search.performed %}תוצאות עבור ״{{ search.terms | escape }}״{% else %}מה מחפשים?{% endif %}</h1>
      <form action="{{ routes.search_url }}" method="get" role="search" style="display:flex;gap:10px;margin-top:26px;max-width:560px">
        <label class="lx-sr" for="lx-search-q">חיפוש</label>
        <div class="lx-field" style="flex:1;margin:0"><input id="lx-search-q" type="search" name="q" value="{{ search.terms | escape }}" placeholder="למשל: כוס רוח"></div>
        <input type="hidden" name="type" value="product">
        <button class="lx-btn" type="submit">חיפוש</button>
      </form>
    </header>
    {%- if search.performed -%}
      {%- paginate search.results by 12 -%}
        {%- if search.results_count == 0 -%}
          <div class="lx-cart__empty" style="padding-bottom:var(--lx-sec)"><h2 class="lx-h3">לא מצאנו תוצאות</h2><p>בדקו את האיות או נסו מילה כללית יותר.</p><a class="lx-btn" href="{{ routes.all_products_collection_url }}">לכל המוצרים</a></div>
        {%- else -%}
          <div class="lx-toolbar"><span role="status">{{ search.results_count }} תוצאות</span></div>
          <ul class="lx-grid lx-grid--4" style="padding-bottom:var(--lx-sec)">
            {%- for item in search.results -%}
              {%- if item.object_type == 'product' -%}
                <li>{% render 'lx2-card', product: item %}</li>
              {%- else -%}
                <li><a class="lx-card" href="{{ item.url }}"><h3 class="lx-card__t">{{ item.title | escape }}</h3><p class="lx-card__p">{{ item.content | strip_html | truncatewords: 18 }}</p></a></li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
          {%- if paginate.pages > 1 -%}
            <nav class="lx-pager" aria-label="עמודים" style="margin:-40px 0 var(--lx-sec)">
              {%- for part in paginate.parts -%}
                {%- if part.is_link -%}<a href="{{ part.url }}">{{ part.title }}</a>{%- else -%}<span class="{% if part.title == paginate.current_page %}is-cur{% endif %}">{{ part.title }}</span>{%- endif -%}
              {%- endfor -%}
            </nav>
          {%- endif -%}
        {%- endif -%}
      {%- endpaginate -%}
    {%- else -%}
      <div style="padding-bottom:var(--lx-sec)"></div>
    {%- endif -%}
  </div>
</div>
{% schema %}
{ "name": "LORINX חיפוש", "settings": [] }
{% endschema %}
