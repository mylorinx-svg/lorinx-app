{%- comment -%}
  lx2 list: heading + numbered / labelled items. Layouts: split (sticky heading beside a list),
  cols-2, cols-3, steps (three large numerals) and timeline (label + text).
{%- endcomment -%}
{%- liquid
  assign show = true
  if section.settings.only_for != blank and section.settings.only_for != product.handle
    assign show = false
  endif
  assign layout = section.settings.layout
-%}
{%- if show -%}
<section class="lx2 lx-sec lx-tone-{{ section.settings.tone }}" {% if section.settings.anchor != blank %}id="{{ section.settings.anchor | handleize }}"{% endif %}>
  <div class="lx-wrap {% if layout == 'split' or layout == 'timeline' %}lx-split{% endif %}">
    <div class="lx-head" data-lx-reveal>
      {%- if section.settings.eyebrow != blank -%}<span class="lx-eyebrow">{{ section.settings.eyebrow | escape }}</span>{%- endif -%}
      <h2 class="lx-h2" data-lx-split>{{ section.settings.heading | escape }}</h2>
      {%- if section.settings.text != blank -%}<p class="lx-lead">{{ section.settings.text | escape }}</p>{%- endif -%}
    </div>
    <div>
      <ol {% if layout == 'steps' %}data-lx-progress{% endif %} class="lx-list {% case layout %}{% when 'cols-2' %}lx-list--cols-2{% when 'cols-3' %}lx-list--cols-3{% when 'steps' %}lx-list--steps{% when 'timeline' %}lx-list--timeline{% endcase %} {% unless section.settings.numbered or layout == 'timeline' %}lx-list--plain{% endunless %}">
        {%- for block in section.blocks -%}
          <li class="lx-item" {{ block.shopify_attributes }} data-lx-reveal>
            {%- if layout == 'timeline' -%}
              <span class="lx-item__n lx-item__n--label">{{ block.settings.label | escape }}</span>
            {%- elsif section.settings.numbered -%}
              <span class="lx-item__n" aria-hidden="true">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
            {%- endif -%}
            {%- if block.settings.title != blank -%}<h3>{{ block.settings.title | escape }}</h3>{%- endif -%}
            {%- if block.settings.text != blank -%}<p>{{ block.settings.text | escape }}</p>{%- endif -%}
          </li>
        {%- endfor -%}
      </ol>
      {%- if section.settings.note != blank -%}<p class="lx-dd__note">{{ section.settings.note | escape }}</p>{%- endif -%}
    </div>
  </div>
</section>
{%- endif -%}
{% schema %}
{
  "name": "LORINX רשימה",
  "max_blocks": 8,
  "settings": [
    { "type": "text", "id": "only_for", "label": "להציג רק במוצר — handle של המוצר (ריק = בכל מקום)" },
    { "type": "text", "id": "anchor", "label": "מזהה עוגן (אנגלית)" },
    { "type": "text", "id": "eyebrow", "label": "כותרת עליונה" },
    { "type": "text", "id": "heading", "label": "כותרת", "default": "כותרת" },
    { "type": "textarea", "id": "text", "label": "טקסט" },
    { "type": "textarea", "id": "note", "label": "הערה מתחת לרשימה" },
    { "type": "select", "id": "layout", "label": "פריסה", "default": "split", "options": [
      { "value": "split", "label": "כותרת לצד רשימה" }, { "value": "cols-2", "label": "שתי עמודות" }, { "value": "cols-3", "label": "שלוש עמודות" },
      { "value": "steps", "label": "שלבים" }, { "value": "timeline", "label": "ציר זמן" } ] },
    { "type": "checkbox", "id": "numbered", "label": "מספור", "default": true },
    { "type": "select", "id": "tone", "label": "רקע", "default": "bg", "options": [
      { "value": "bg", "label": "בהיר" }, { "value": "surface", "label": "לבן חם" }, { "value": "sand", "label": "חול" }, { "value": "dark", "label": "כהה" } ] }
  ],
  "blocks": [{ "type": "item", "name": "פריט", "settings": [
    { "type": "text", "id": "label", "label": "תווית (לציר זמן)" },
    { "type": "text", "id": "title", "label": "כותרת" },
    { "type": "textarea", "id": "text", "label": "טקסט" } ] }],
  "presets": [{ "name": "LORINX רשימה" }]
}
{% endschema %}
